    private static volatile Set<Locale> cAvailableLocaleSet;

    private static synchronized void initializeAvailableLocaleSet() {
        if (cAvailableLocaleSet == null) {
            cAvailableLocaleSet = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(Locale.getAvailableLocales())));
        }
